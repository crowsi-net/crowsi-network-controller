{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://network/control-requests/v1",
  "title": "Crowsi network control request v1",
  "x-crowsi-max-request-window-ms": 3600000,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "idempotency_key",
    "target_id",
    "action",
    "scope",
    "mode",
    "requested_by",
    "requested_at",
    "expires_at"
  ],
  "properties": {
    "schema": { "const": "crowsi://network/control-requests/v1" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "idempotency_key": { "$ref": "#/$defs/identifier" },
    "target_id": { "$ref": "#/$defs/identifier" },
    "action": {
      "enum": [
        "quarantine-interface",
        "restrict-egress",
        "restore-egress",
        "enter-maintenance",
        "exit-maintenance"
      ]
    },
    "scope": { "$ref": "#/$defs/identifier" },
    "mode": { "const": "dry-run" },
    "requested_by": { "$ref": "#/$defs/identifier" },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    }
  }
}
