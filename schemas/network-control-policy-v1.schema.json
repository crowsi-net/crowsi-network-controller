{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://network/control-policies/v1",
  "title": "Crowsi network control policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "enabled", "rules"],
  "properties": {
    "schema": { "const": "crowsi://network/control-policies/v1" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "enabled": { "type": "boolean" },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_id", "action", "scope", "requesters"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "target_id": { "$ref": "#/$defs/identifier" },
        "action": {
          "enum": [
            "quarantine-interface",
            "restrict-egress",
            "restore-egress",
            "enter-maintenance",
            "exit-maintenance"
          ]
        },
        "scope": { "$ref": "#/$defs/identifier" },
        "requesters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
